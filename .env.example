# CoinSignal 환경 설정 (이 파일을 .env 로 복사해서 사용)
# 웹 화면/API 주소. 로컬 PC는 127.0.0.1 유지 권장. AWS에서는 127.0.0.1 + 리버스 프록시(HTTPS) 권장
HOST=127.0.0.1
PORT=8787

# 데이터 폴더 (SQLite DB, 암호화 키 파일)
COINSIGNAL_DATA_DIR=data

# API 키 암호화용 마스터 키 (base64 32바이트). 비워두면 data/master.key 를 자동 생성합니다.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COINSIGNAL_MASTER_KEY=

# HTTPS 뒤에서 운영할 때 true (쿠키 Secure 플래그)
COINSIGNAL_SECURE_COOKIES=false

# 리버스 프록시(Nginx/Caddy) 뒤에서만 true: X-Forwarded-For/Host 신뢰
COINSIGNAL_TRUST_PROXY=false
